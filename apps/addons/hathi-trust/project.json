{
  "name": "hathi-trust-addon",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "umn",
  "sourceRoot": "apps/addons/hathi-trust/src",
  "tags": ["type:app", "scope:addon"],
  "targets": {
    "serve": {},
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "hathi-trust-addon:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "hathi-trust-addon:build",
        "spa": true
      }
    }
  }
}
